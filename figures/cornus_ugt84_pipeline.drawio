        </mxCell>
        <mxCell id="florida" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=10;fillColor=light-dark(#E7F1F8,#FFFFFF);strokeColor=#2878A8;strokeWidth=6;fontSize=20;fontColor=light-dark(#202A32,#000000);labelBackgroundColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;b&gt;C. FLORIDA — PROTEIN SCREEN&lt;/b&gt;&lt;br&gt;1. RefSeq protein FASTA&lt;br&gt;2. HMMER &lt;i&gt;hmmsearch&lt;/i&gt; with PF00201: 257 broad-family hits&lt;br&gt;3. Python exact HCGWNS-core scan: 160 hits&lt;br&gt;4. BLASTP vs 24 UGT84 references; GFF/locus mapping&lt;br&gt;5. Selected: 20 proteins at 20 loci" vertex="1">
          <mxGeometry height="230" width="880" x="50" y="230" as="geometry" />
        </mxCell>
