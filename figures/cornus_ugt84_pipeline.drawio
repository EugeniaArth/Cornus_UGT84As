        <mxCell id="references" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=light-dark(#F0EDF8,#FFFFFF);strokeColor=#7356A5;strokeWidth=6;fontSize=19;fontColor=light-dark(#202A32,#000000);labelBackgroundColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;b&gt;REFERENCE / CONTEXT PANEL — 32 PROTEINS&lt;/b&gt;&lt;br&gt;24 UGT84 A/B/J · 6 UGT74 Group-L comparators · 2 family-1 context sequences (Groups E/H)&lt;br&gt;Python: stage sources → build panel → validate panel · the 24 UGT84 references are used in both BLASTP comparisons" vertex="1">
